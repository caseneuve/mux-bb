;; E2E tests for the tmux backend.
;; Requires real tmux — runs in podman container with tmux installed.
;;
;; Tests actual session creation, window management, send/capture round-trips.
;; cmux E2E is not possible (macOS GUI app, can't run in containers).

[{:suite :tmux-session-info
  :desc "derive-session-info produces usable tmux identifiers"
  :cases
  [{:scenario :deterministic-output
    :desc "Same project+branch always produces the same socket and session"
    :when {:run ["bb" "-cp" "src"
                 "-e" "(require '[mux.tmux :as t])
                       (let [a (t/derive-session-info \"proj\" \"main\")
                             b (t/derive-session-info \"proj\" \"main\")]
                         (assert (= a b))
                         (println \"sock:\" (:sock a))
                         (println \"session:\" (:session a)))"]}
    :then [[:exit-code 0]
           [:stdout-contains "sock: /tmp/mux.sock"]
           [:stdout-contains "session: proj-"]]}

   {:scenario :different-branches-differ
    :desc "Different branches produce different sessions"
    :when {:run ["bb" "-cp" "src"
                 "-e" "(require '[mux.tmux :as t])
                       (let [a (t/derive-session-info \"proj\" \"main\")
                             b (t/derive-session-info \"proj\" \"dev\")]
                         (assert (not= (:session a) (:session b)))
                         (println \"OK\"))"]}
    :then [[:exit-code 0]
           [:stdout-contains "OK"]]}]}

 {:suite :tmux-backend-lifecycle
  :desc "tmux backend: create session, send command, capture output"
  :given {:vars {:sock "/tmp/mux-bb-test.sock"
                 :session "mux-bb-test"}}
  :setup-cmd ["tmux" "-S" "{sock}" "new-session" "-d" "-s" "{session}" "-x" "200" "-y" "50"]
  :teardown-cmd ["tmux" "-S" "{sock}" "kill-server"]
  :cases
  [{:scenario :new-window-and-list
    :desc "Create a window and verify it appears in list"
    :when {:run ["bb" "-cp" "src"
                 "-e" "(require '[mux.tmux :as t])
                       (let [be (t/make-backend {:sock \"{sock}\" :session \"{session}\"})]
                         ((:new-window! be) \"test-win\")
                         (let [wins ((:list! be))]
                           (assert (some #(= \"test-win\" %) wins)
                                   (str \"test-win not found in: \" wins))
                           (println \"windows:\" (pr-str wins))))"]}
    :then [[:exit-code 0]
           [:stdout-contains "test-win"]]}

   {:scenario :send-and-capture
    :desc "Send a command and capture its output"
    :when {:run ["bb" "-cp" "src"
                  "-e" "(require '[mux.tmux :as t])
                        (let [be (t/make-backend {:sock \"{sock}\" :session \"{session}\"})]
                          ((:new-window! be) \"echo-win\")
                          ((:send! be) \"echo-win\" \"echo HELLO_MUX_BB\")
                          (Thread/sleep 500)
                          (let [out ((:capture! be) \"echo-win\")]
                            (assert (clojure.string/includes? out \"HELLO_MUX_BB\")
                                    (str \"Expected HELLO_MUX_BB in output, got: \" out))
                            (println \"captured OK\")))"]}
    :then [[:exit-code 0]
           [:stdout-contains "captured OK"]]}

   {:scenario :spawn-pane-and-capture
    :desc "Spawn split pane, run command, verify output can be captured from spawned pane"
    :when {:run ["bb" "-cp" "src"
                 "-e" "(require '[mux.tmux :as t]
                                '[clojure.string :as str])
                       (let [be (t/make-backend {:sock \"{sock}\" :session \"{session}\"})]
                         ((:new-window! be) \"pane-win\")
                         (let [meta ((:spawn-pane! be) {:target \"{session}:pane-win.0\"
                                                        :direction :right
                                                        :command \"sh -lc 'echo PANE_OK; sleep 2'\"})]
                           (assert (re-find #\"^%\\d+$\" (:pane-id meta)) (str \"bad pane-id: \" meta))
                           (Thread/sleep 500)
                           (let [out (t/tmux! \"{sock}\" \"capture-pane\" \"-t\" (:pane-id meta) \"-p\" \"-S\" \"-50\")]
                             (assert (str/includes? out \"PANE_OK\")
                                     (str \"Expected PANE_OK in pane output, got: \" out))
                             (println \"spawn captured OK\"))))"]}
    :then [[:exit-code 0]
           [:stdout-contains "spawn captured OK"]]}

   {:scenario :async-send-deterministic-marker
    :desc "Async send completes with deterministic marker and bounded polling"
    :when {:run ["bb" "-cp" "src"
                 "-e" "(require '[mux.tmux :as t]
                                '[clojure.string :as str])
                       (let [be (t/make-backend {:sock \"{sock}\" :session \"{session}\"})
                             marker \"ASYNC_DONE_0004\"]
                         ((:new-window! be) \"async-win\")
                         (let [f ((:send-async! be) \"async-win\" (str \"echo \" marker))]
                           (assert (not= :timeout (deref f 2000 :timeout)) \"send-async! timed out\"))
                         (loop [i 0]
                           (let [out ((:capture! be) \"async-win\")]
                             (cond
                               (str/includes? out marker) (println \"async marker observed\")
                               (< i 10) (do (Thread/sleep 100) (recur (inc i)))
                               :else (throw (ex-info \"marker not observed within bounded polls\" {:marker marker}))))))"]}
    :then [[:exit-code 0]
           [:stdout-contains "async marker observed"]]}]}]
